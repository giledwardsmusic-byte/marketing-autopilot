# Copy to .dev.vars for local development only. Never commit real secrets.
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-long-password
SESSION_SECRET=replace-with-long-random-secret

# Optional AI. Set AI_PROVIDER=openai or anthropic and supply matching key/model.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=

# Optional real publishing connectors.
BUFFER_API_KEY=
MAILERLITE_API_KEY=

# Pinterest OAuth. Create the app in Pinterest Developers, then keep the real
# client secret in Cloudflare Worker secrets rather than source control.
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=

# Public origin used to serve R2 media to publishing services.
APP_ORIGIN=http://localhost:8787
# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=
# Optional: enables signed Payhip paid/refunded webhook tracking.
PAYHIP_API_KEY=

# Optional free-first outbound alerts via Resend.
# Leave blank to keep email alerts disabled. Never commit the real API key.
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# Google Drive source/archive sync. Uses the designated folder by default.
# Requires one-time Google OAuth authorization with Drive read/write scope.
GOOGLE_DRIVE_FOLDER_ID=13V50CtAtjWRZ0H_F9kBbjDdWBdsjxxDE
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
